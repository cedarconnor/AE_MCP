{
  "name": "after-effects-uber-mcp",
  "version": "0.1.0",
  "description": "Consolidated After Effects MCP for editable motion graphics, inspection and review",
  "keywords": [
    "adobe",
    "after-effects",
    "aftereffects",
    "claude",
    "extendscript",
    "llm",
    "mcp",
    "model-context-protocol",
    "motion-graphics"
  ],
  "license": "MIT",
  "author": "After Effects Uber MCP contributors (derived from kumo.productions)",
  "bin": {
    "ae-uber-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "jsx",
    "fixtures",
    "docs",
    "examples",
    "scripts/smoke-live.mjs",
    "scripts/check-protocol.mjs",
    "scripts/generate-reference-docs.mjs",
    "scripts/generate-tools-doc.mjs",
    "scripts/doc-examples.mjs",
    "scripts/check-docs.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run --exclude tests/e2e/**",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:jsx": "vitest run tests/lint-jsx.test.ts",
    "docs:tools": "npm run docs:generate",
    "docs:generate": "npm run build && node scripts/generate-reference-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-reference-docs.mjs --check && node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run typecheck:test && npm run build && npm test && npm run check:protocol && node scripts/generate-reference-docs.mjs --check && node scripts/check-docs.mjs",
    "prepublishOnly": "npm run build",
    "test:live": "vitest run tests/e2e",
    "check:protocol": "node scripts/check-protocol.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
